# Google AI Studio에서 발급받은 키를 입력합니다.
# 브라우저 코드나 NEXT_PUBLIC_ 환경 변수에는 넣지 마세요.
GEMINI_API_KEY=

# Supabase Project Settings > API에서 확인할 수 있는 공개 값입니다.
# service_role 또는 secret 키는 절대 NEXT_PUBLIC_ 변수에 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
